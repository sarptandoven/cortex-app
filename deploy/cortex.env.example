# Cortex hosted backend — production environment (beta profile).
# bootstrap.sh renders this into /etc/cortex/cortex.env with generated secrets.
# Every value here is read by backend/app/config.py load_settings().

# --- identity of the deployment ---
CORTEX_PUBLIC_BASE_URL=https://__API_DOMAIN__
CORTEX_PUBLIC_APP_URL=https://__API_DOMAIN__

# --- operator admin token (control plane only; never give to users) ---
CORTEX_API_KEY=__ADMIN_TOKEN__

# --- multi-tenant runtime (the sanctioned sharded-SQLite tier) ---
CORTEX_SHARD_MODE=bucket
CORTEX_SHARD_COUNT=16
CORTEX_SHARD_ROOT=/var/lib/cortex/shards
CORTEX_REQUIRE_SCOPED_API_TOKENS=1
CORTEX_HOSTED_RUNTIME_TIER=sharded_sqlite
CORTEX_WORKER_MODE=external
CORTEX_SYNC_SIGNING_KEY=__SIGNING_KEY__

# --- accounts + auth (BETA profile: signup without email infrastructure) ---
CORTEX_AUTH_ENABLED=1
# Beta only: activate accounts at signup (no verification email). Turn OFF and set up
# CORTEX_AUTH_EMAIL_MODE=smtp + a transactional provider before PUBLIC launch.
CORTEX_AUTH_AUTOVERIFY=1
CORTEX_AUTH_EMAIL_MODE=log
CORTEX_AUTH_RATE_LIMIT_PER_MINUTE=30
# GitHub login (works instantly once you create a GitHub OAuth app; callback URL:
# https://api.signindoppl.com/v1/auth/oauth/github/callback)
#CORTEX_OIDC_GITHUB_CLIENT_ID=
#CORTEX_OIDC_GITHUB_CLIENT_SECRET=
# Google login (needs consent-screen publishing review before >100 users; redirect URI:
# https://api.signindoppl.com/v1/auth/oauth/google/callback)
#CORTEX_OIDC_GOOGLE_CLIENT_ID=
#CORTEX_OIDC_GOOGLE_CLIENT_SECRET=
# Sign in with Apple (NATIVE macOS flow). The id_token audience is the app's bundle id, so set this
# to the bundle id; no client secret is needed for the native flow. Enable "Sign in with Apple" on
# the App ID com.cortex.doppl in the Apple Developer portal first.
#CORTEX_OIDC_APPLE_CLIENT_ID=com.cortex.doppl

# --- email (PUBLIC launch: turn AUTOVERIFY off above, set these) ---
# With a real SMTP provider (Postmark/SES/etc.), verification + password-reset
# links are delivered by email. If mode=smtp but no host is set, the server
# safely degrades to the log sink. Warm the sending domain (SPF/DKIM/DMARC)
# before public launch.
#CORTEX_AUTH_EMAIL_MODE=smtp
#CORTEX_SMTP_HOST=smtp.postmarkapp.com
#CORTEX_SMTP_PORT=587
#CORTEX_SMTP_USERNAME=
#CORTEX_SMTP_PASSWORD=
#CORTEX_SMTP_FROM_ADDR=Cortex <hello@trydoppl.com>

# --- per-user encryption (KEK generated by bootstrap; ESCROW IT OFFLINE) ---
CORTEX_KEK_FILE=/etc/cortex/kek

# --- fair use: non-zero ON PURPOSE (0 disables) ---
CORTEX_RATE_LIMIT_PER_MINUTE=120
CORTEX_DEFAULT_MEMORY_QUOTA=20000

# --- retrieval quality: real on-device embeddings, zero API cost ---
CORTEX_EMBEDDING_PROVIDER=model2vec

# --- observability ---
CORTEX_OBSERVABILITY_ENABLED=1

# --- python ---
PYTHONDONTWRITEBYTECODE=1

# --- OAuth token-exchange broker (option A: confidential connectors) ----------
# Hosted-only. Set per confidential provider to enable one-tap "Sign in" without shipping a secret
# in the desktop app. Absent = that connector shows "Coming soon". No app rebuild needed to add one.
# Register the app per docs/OAUTH_SETUP.md, then set:
# CORTEX_BROKER_NOTION_CLIENT_ID=
# CORTEX_BROKER_NOTION_CLIENT_SECRET=
# CORTEX_BROKER_GITHUB_CLIENT_ID=
# CORTEX_BROKER_GITHUB_CLIENT_SECRET=
# Optional per-provider overrides: CORTEX_BROKER_<PROVIDER>_AUTHORIZE_URL / _TOKEN_URL / _SCOPES
