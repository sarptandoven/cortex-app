<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Privacy manifest for the Mac App Store (sandboxed) build of Doppl.

    Memory lives in the app's sandbox container and the local engine runs on the loopback
    interface only (the _ssl/ssl.py Python modules are stripped in app-store mode; account
    sign-in uses Swift's native URLSession/HTTPS, not the Python backend). The app offers a
    Cortex account (Sign in with Apple / Google / GitHub / email) to sync memory across the
    user's devices and AI tools. When a user signs in, their email and name are collected to
    operate that account, and memory they choose to sync is sent to their account. None of it
    is used for tracking or shared with third parties for advertising.
  -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!-- Account email — used to operate the user's account; linked to identity; not tracking. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <!-- Name — from the account / Sign in with Apple; linked to identity; not tracking. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeName</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <!-- Memory / notes the user adds to their account (their own content) — synced to the account
         to operate it; linked to identity; not tracking. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
  </array>
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <!--
      File-timestamp APIs (stat/lstat/getattrlist/DIR* modification dates) are used
      to read and manage files the user explicitly selects. Reason C617.1: the
      timestamp is used only inside the app's own container / on user-selected files.
    -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>
    <!--
      UserDefaults is used to store this app's own settings. Reason CA92.1:
      access info from the app itself only.
    -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
    <!--
      System boot time. The bundled CPython framework maps time.monotonic()
      (used for rate-limit timers, request timing, and uptime measurement in the
      local backend) to mach_absolute_time(), which Apple's static scanner
      detects in the Python.framework binary. Reason 35F9.1: measure elapsed
      time between events within the app / drive timers. Declared to satisfy the
      required-reason API rule (prevents ITMS-91053 on upload); no data leaves
      the device.
    -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>35F9.1</string>
      </array>
    </dict>
    <!--
      Disk-space APIs. The bundled CPython framework's stdlib (shutil.disk_usage,
      os.statvfs, and the storage engine's own file-size / vault-size accounting)
      links statfs/statvfs, which Apple's static scanner detects in the
      Python.framework binary. Reason E174.1: display disk-space information to the
      user / manage the app's own storage (backups, vault size in Settings).
      Declared to satisfy the required-reason API rule (prevents ITMS-91053 on
      upload); no data leaves the device.
    -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>E174.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
