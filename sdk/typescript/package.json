{
  "name": "@cortex/client",
  "version": "0.1.0",
  "description": "Dependency-free (fetch-based) client for the Cortex local memory server.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cortex",
    "memory",
    "mcp",
    "llm",
    "agent",
    "context"
  ],
  "license": "MIT",
  "homepage": "https://trydoppl.com",
  "repository": { "type": "git", "url": "https://github.com/doppl-tech/cortex-app.git", "directory": "sdk/typescript" },
  "bugs": { "url": "https://github.com/doppl-tech/cortex-app/issues" },
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
