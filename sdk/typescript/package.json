{
  "name": "@doppl-tech/cortex-client",
  "version": "0.1.0",
  "description": "Dependency-free (fetch-based) client for the Cortex local memory server.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/*.test.js",
    "posttest": "rm -rf dist-test"
  },
  "keywords": [
    "cortex",
    "memory",
    "mcp",
    "llm",
    "agent",
    "context"
  ],
  "license": "MIT",
  "homepage": "https://trydoppl.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/trace-cortex/cortex-app.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/trace-cortex/cortex-app/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.4.0"
  }
}
